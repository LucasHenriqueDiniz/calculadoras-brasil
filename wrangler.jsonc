{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calcule-brasil",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // calcule-brasil.lucas-hdo.workers.dev served the whole site with a 200 and no noindex: a second
  // copy of calculebrasil.com. The apex is attached in the dashboard, not here, and wrangler only
  // publishes the routes this file declares, so turning workers.dev off leaves the apex alone.
  // Preview URLs stay on, explicitly: with `preview_urls` absent, wrangler 4.160's deploy warns that
  // they go off together with workers.dev, and the Workers Builds check on every PR posts one. They
  // answer with `X-Robots-Tag: noindex` (measured 2026-11-14), so they are not a duplicate.
  "workers_dev": false,
  "preview_urls": true,
  // Prerendering writes `<route>/index.html`, and the asset server's default
  // `auto-trailing-slash` then answers the canonical form with a 307 to the
  // trailing-slash one. Every canonical tag and every sitemap entry uses the
  // no-slash form, so the default made the canonical URL a URL that never
  // returns 200. Dropping the slash instead serves it directly, which is the
  // form already published everywhere.
  "assets": {
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // The edge cache keys public data by the deployed version (src/server/edge-cache-key.ts), so a
  // deploy is never answered by an entry the previous code wrote.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://calculebrasil.com",
    "PUBLIC_DATA_CACHE_TTL_HOURS": "24",
  },
  "env": {
    "preview": {
      "name": "calcule-brasil-preview",
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "PUBLIC_SITE_URL": "https://calcule-brasil-preview.lucas-hdo.workers.dev",
        "PUBLIC_DATA_CACHE_TTL_HOURS": "24",
      },
    },
  },
}
